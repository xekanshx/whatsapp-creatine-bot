# Copy to .env for local dev (npm run dev). On Render, set these in the dashboard instead.

# --- Meta WhatsApp Cloud API ---
# Permanent access token from a System User (Meta Business Settings). The temporary
# token shown on the API Setup page expires after 24h, so don't use it for real.
WHATSAPP_TOKEN=
# "Phone number ID" shown on the WhatsApp > API Setup page (NOT the phone number itself).
PHONE_NUMBER_ID=
# Your personal WhatsApp number, digits only, with country code, no "+" or spaces.
# e.g. 919876543210. Messages from any other number are ignored.
MY_WHATSAPP_NUMBER=
# Any random string you invent. You'll paste the same value into Meta's webhook config.
VERIFY_TOKEN=

# --- Upstash Redis (REST API) ---
# From the Upstash console: your database > REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron guard ---
# Random secret; cron-job.org calls /send-checkin?secret=<this value>.
CRON_SECRET=

# --- Google Gemini ---
# Free key from https://aistudio.google.com/app/apikey (Google account, no billing needed).
GEMINI_API_KEY=

# --- Server ---
# Render injects PORT automatically; only needed locally.
PORT=3000

# --- Optional ---
# IANA timezone used to decide what "today" is and which hours check-ins fire
# (12:00-23:59 local). Defaults to UTC if unset. e.g. Asia/Kolkata, America/New_York
TIMEZONE=UTC
